{
  "manifest_version": 3,
  "name": "AXIOM - The Anti-Copilot",
  "version": "1.0",
  "description": "False-Positive Proofing & Intent Checking for AXIOM Life OS",
  "permissions": ["tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
